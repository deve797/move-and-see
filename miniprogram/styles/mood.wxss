.mood-options { display: flex; gap: 6px; margin-top: 24px; }
.mood-options .mood-option { display: flex; flex: 1; min-width: 0; flex-direction: column; align-items: center; justify-content: center; gap: 12px; min-height: 94px; padding: 12px 0; border: 1px solid transparent; border-radius: 12px; background: #f3f4f1; color: #50584d; line-height: 1.5; }
.mood-options .mood-selected { background: #e5ece5; border-color: #6a8067; color: #263c28; }
.mood-options .mood-option-pressed { background: #e5ece5; }
.mood-label { font-size: 13px; white-space: nowrap; }
.mood-face { position: relative; width: 34px; height: 34px; border: 1.5px solid currentColor; border-radius: 50%; }
.mood-eyes::before, .mood-eyes::after { content: ""; position: absolute; top: 10px; width: 3px; height: 3px; border-radius: 50%; background: currentColor; }
.mood-eyes::before { left: 8px; }
.mood-eyes::after { right: 8px; }
.mood-mouth { position: absolute; left: 9px; top: 21px; width: 13px; height: 1.5px; background: currentColor; }
.face-low .mood-mouth, .face-down .mood-mouth { top: 19px; height: 6px; border: 1.5px solid currentColor; border-bottom: 0; border-radius: 10px 10px 0 0; background: transparent; }
.face-low .mood-mouth { top: 17px; height: 8px; }
.face-good .mood-mouth, .face-great .mood-mouth { top: 18px; height: 7px; border: 1.5px solid currentColor; border-top: 0; border-radius: 0 0 10px 10px; background: transparent; }
.face-great .mood-mouth { height: 8px; background: currentColor; }
.note-section { margin-top: 28px; }
.note-heading { font-size: 16px; line-height: 1.6; font-weight: 600; }
.note-optional { color: #71746f; font-weight: 400; }
.note-field { margin-top: 12px; padding: 16px; border: 1px solid transparent; border-radius: 16px; background: #f3f4f1; }
.note-field.is-focused { border-color: #7f897b; }
.mood-textarea { display: block; box-sizing: border-box; width: 100%; height: 88px; font-size: 16px; line-height: 1.7; color: #181917; }
.note-placeholder { color: #686d65; }
.note-count { margin-top: 8px; color: #686d65; font-size: 12px; line-height: 1.5; text-align: right; font-variant-numeric: tabular-nums; }
@media (max-width: 340px) {
  .mood-options { gap: 5px; }
  .mood-label { font-size: 12px; }
  .note-section { margin-top: 24px; }
  .note-field { padding: 14px; }
}
