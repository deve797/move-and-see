.calendar-button { display: flex; width: 44px; height: 44px; align-items: center; justify-content: center; margin-right: -10px; }
.calendar-icon { position: relative; width: 19px; height: 20px; border: 2px solid #181917; border-radius: 3px; }
.calendar-icon::before { content: ""; position: absolute; top: 4px; left: 0; right: 0; border-top: 2px solid #181917; }
.calendar-binding { position: absolute; top: -4px; left: 3px; width: 8px; height: 5px; border-left: 2px solid #181917; border-right: 2px solid #181917; }
.calendar-dot { position: absolute; left: 3px; top: 9px; width: 3px; height: 3px; background: #181917; }
