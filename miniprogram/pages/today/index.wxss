@import "../../styles/calendar.wxss";
@import "../../styles/mood.wxss";
.today-page { min-height: 100vh; padding: 8px 40rpx 28px; padding-bottom: calc(28px + env(safe-area-inset-bottom)); }
.today-header { display: flex; align-items: center; justify-content: space-between; padding: 0 8rpx; }
.today-header .brand { align-self: center; }
.today-header .week-entry { width: auto; min-height: 44px; gap: 8px; margin-right: 0; padding: 0 4px; color: #50584d; font-size: 14px; line-height: 1.5; white-space: nowrap; }
.week-entry .calendar-icon { flex-shrink: 0; }
.calendar-pressed { opacity: .55; }
.today-intro { margin: 27px 8rpx 24px; }
.today-title { font-size: 80rpx; line-height: 1.3; font-weight: 700; }
.today-description { margin-top: 13px; color: #71746f; font-size: 16px; line-height: 1.7; }
.weekly-progress { margin: 0 8rpx 24px; }
.progress-title { color: #50584d; font-size: 14px; line-height: 1.6; }
.progress-count { margin-top: 4px; color: #344c36; font-size: 20px; line-height: 1.6; font-weight: 600; font-variant-numeric: tabular-nums; }
.period-control { margin: 0 8rpx 24px; }
.period-button { min-height: 44px; padding: 10px 16px; border: 1px solid #ccd4c8; border-radius: 12px; background: #fff; color: #344c36; font-size: 15px; line-height: 1.6; text-align: left; }
.period-selected { background: #e5ece5; }
.period-hint { margin-top: 8px; color: #71746f; font-size: 13px; line-height: 1.7; }
.period-walk { margin-bottom: 24px; padding: 20px; border: 1px solid #ccd4c8; border-radius: 16px; }
.walk-title { font-size: 24px; line-height: 1.4; font-weight: 700; }
.walk-status { margin-top: 12px; color: #344c36; font-size: 15px; line-height: 1.6; font-weight: 600; }
.walk-actions { display: flex; gap: 12px; margin-top: 12px; }
.walk-actions .period-button { flex: 1; min-width: 0; text-align: center; }
.period-badge { padding: 12px 24px 0; color: #344c36; font-size: 14px; line-height: 1.6; font-weight: 600; }
.activity-card { position: relative; margin-top: 16px; border-radius: 16px; overflow: hidden; background: #f3f4f1; }
.activity-card:first-child { margin-top: 0; }
.yoga { background: #e5ece5; }
.running { background: #f3f4f1; }
.card-link { display: block; position: relative; min-height: 272px; overflow: hidden; }
.card-pressed { background: rgba(24,25,23,.04); }
.card-copy { position: relative; z-index: 1; padding: 26px 24px; pointer-events: none; }
.activity-title { font-size: 32px; font-weight: 700; line-height: 1.3; }
.activity-time { font-size: 32px; font-weight: 700; line-height: 1.3; margin-top: 10px; font-variant-numeric: tabular-nums; }
.yoga-art { position: absolute; width: 205px; height: 205px; right: 2px; bottom: 2px; overflow: hidden; pointer-events: none; }
.yoga-sheet { position: absolute; left: 0; top: 0; width: 400%; height: 200%; }
.running-art { position: absolute; width: 230px; height: 230px; right: -2px; bottom: -4px; pointer-events: none; }
.exercise-art { position: absolute; right: 0; bottom: 0; width: 230px; height: 230px; pointer-events: none; }
.yoga-motion { width: 215px; height: 215px; }
.status-pressed { opacity: .55; }
.record-entry { display: flex; align-items: center; justify-content: space-between; min-height: 48px; padding: 10px 24px; border-top: 1px solid rgba(80,88,77,.12); color: #344c36; font-size: 15px; line-height: 1.6; }
.today-page .before-mood-entry { display: flex; align-items: center; justify-content: space-between; width: 100%; min-height: 48px; padding: 10px 24px; border-top: 1px solid rgba(80,88,77,.12); border-radius: 0; background: transparent; color: #50584d; font-size: 13px; line-height: 1.6; text-align: left; }
.before-mood-value { display: flex; align-items: center; gap: 10px; }
.has-mood .before-mood-value { color: #344c36; font-weight: 600; }
.mood-chevron { width: 6px; height: 6px; border-top: 1.5px solid currentColor; border-right: 1.5px solid currentColor; transform: rotate(45deg); }
.before-mood-sheet { padding: 22px 20px 24px; padding-bottom: calc(24px + env(safe-area-inset-bottom)); background: #fff; }
.mood-sheet-header { display: flex; align-items: center; justify-content: space-between; gap: 8px; }
.mood-sheet-title { font-size: 23px; line-height: 1.4; font-weight: 700; }
.before-mood-sheet .mood-sheet-close { display: flex; flex-shrink: 0; align-items: center; justify-content: center; width: 44px; height: 44px; margin-right: -8px; background: transparent; border-radius: 50%; }
.close-mark { position: relative; width: 16px; height: 16px; }
.close-mark::before, .close-mark::after { content: ""; position: absolute; left: 7px; top: 0; width: 1.5px; height: 16px; background: #50584d; transform: rotate(45deg); }
.close-mark::after { transform: rotate(-45deg); }
.mood-sheet-context { margin-top: 4px; color: #686d65; font-size: 14px; line-height: 1.6; }
.mood-sheet-scroll { height: calc(466px + env(safe-area-inset-bottom)); max-height: calc(100vh - 24px); }
.before-mood-sheet .mood-options { margin-top: 20px; }
.before-mood-sheet .note-section { margin-top: 20px; }
.before-mood-sheet .note-field { margin-top: 10px; padding: 12px; }
.before-mood-sheet .mood-textarea { height: 64px; }
.before-mood-sheet .mood-sheet-done { width: 100%; min-height: 48px; margin-top: 16px; border-radius: 24px; font-size: 16px; line-height: 1.5; }
.review-entry { display: flex; align-items: center; justify-content: space-between; min-height: 48px; margin: 16px 8rpx 0; color: #50584d; font-size: 16px; }
.review-chevron { width: 8px; height: 8px; margin-right: 3px; border-top: 1.5px solid currentColor; border-right: 1.5px solid currentColor; transform: rotate(45deg); }
.share-entry { margin: 20px 8rpx 0; }
.profile-entry { display: flex; align-items: center; justify-content: space-between; min-height: 48px; margin: 8px 8rpx 0; color: #50584d; font-size: 16px; }
@media (max-width: 340px) {
  .today-intro { margin-top: 22px; margin-bottom: 20px; }
  .today-description { font-size: 14px; }
  .card-link { min-height: 252px; }
  .card-copy { padding: 23px 20px; }
  .activity-title, .activity-time { font-size: 29px; }
  .yoga-art { width: 178px; height: 178px; }
  .running-art { width: 197px; height: 197px; }
  .exercise-art { width: 197px; height: 197px; }
  .yoga-motion { width: 190px; height: 190px; }
  .today-page .before-mood-entry, .record-entry { padding-right: 20px; padding-left: 20px; }
  .before-mood-sheet { padding-right: 16px; padding-left: 16px; }
  .mood-sheet-title { font-size: 20px; }
}
