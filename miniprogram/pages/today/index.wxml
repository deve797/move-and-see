<view class="today-page">
  <view wx:if="{{loading}}" class="period-hint" role="status">正在读取云端记录…</view>
  <view wx:elif="{{loadError}}" class="period-hint" role="alert">{{loadError}}<button bindtap="retryLoad">重新读取</button></view>
  <block wx:else>
  <view wx:if="{{saving}}" class="period-hint" role="status">正在保存…</view>
  <view wx:if="{{saveError}}" class="period-hint" role="alert">保存提示：{{saveError}}</view>
  <button wx:if="{{saveConflict}}" disabled="{{saving}}" bindtap="reloadAfterConflict">放弃填写并重新读取</button>
  <view class="today-header">
    <view class="brand serif">Move&See</view>
    <navigator class="calendar-button week-entry" url="/pages/week/index" hover-class="calendar-pressed" aria-label="查看本周计划">
      <view class="calendar-icon" aria-hidden="true"><view class="calendar-binding"></view><view class="calendar-dot"></view></view>
      <text>本周计划</text>
    </navigator>
  </view>
  <view class="today-intro">
    <view class="today-title serif" role="heading" aria-level="1">今天</view>
    <view wx:if="{{!periodWalk && !activities.length}}" class="today-description">今天没有安排</view>
  </view>
  <view class="weekly-progress" role="status">
    <view class="progress-title">本周完成进度</view>
    <view wx:if="{{weeklyProgress.total}}" class="progress-count">已完成 {{weeklyProgress.completed}} / 应完成 {{weeklyProgress.total}}</view>
    <view wx:else class="progress-count">本周无考核计划</view>
  </view>
  <view class="period-control">
    <button disabled="{{saving}}" class="period-button {{periodMarked ? 'period-selected' : ''}}" data-marked="{{!periodMarked}}" bindtap="setPeriod" hover-class="card-pressed" aria-pressed="{{periodMarked}}">{{periodMarked ? '取消当天生理期标记' : '标记今天为生理期'}}</button>
  </view>
  <view wx:if="{{periodMarked}}" class="period-walk">
    <block wx:if="{{!periodWalk}}">
      <button disabled="{{saving}}" class="period-button" bindtap="choosePeriodWalk" hover-class="card-pressed">散步 30 分钟（自愿）</button>
    </block>
    <block wx:else>
      <view class="walk-title serif" role="heading" aria-level="2">散步 · 30 分钟</view>
      <view class="period-hint">自愿选择</view>
      <view class="walk-status" role="status">{{periodWalk.status === 'completed' ? '已完成' : periodWalk.status === 'incomplete' ? '未完成' : '待记录'}}</view>
      <view class="walk-actions" role="group" aria-label="散步 30 分钟的完成情况">
        <button disabled="{{saving}}" class="period-button {{periodWalk.status === 'completed' ? 'period-selected' : ''}}" data-status="completed" bindtap="recordPeriodWalk" hover-class="card-pressed" aria-pressed="{{periodWalk.status === 'completed'}}">已完成</button>
        <button disabled="{{saving}}" class="period-button {{periodWalk.status === 'incomplete' ? 'period-selected' : ''}}" data-status="incomplete" bindtap="recordPeriodWalk" hover-class="card-pressed" aria-pressed="{{periodWalk.status === 'incomplete'}}">未完成</button>
      </view>
    </block>
  </view>
  <view class="activity-list">
    <view wx:for="{{activities}}" wx:key="id" class="activity-card {{item.kind}}">
      <view wx:if="{{item.periodExempt}}" class="period-badge" role="status">生理期免考核</view>
      <view class="card-link" aria-label="{{item.name}}，开始时间{{item.time}}，已添加的安排">
        <view class="card-copy">
          <view class="activity-title serif">{{item.name}}</view>
          <view class="activity-time serif">{{item.time}}</view>
        </view>
        <view wx:if="{{!moodSheetOpen && item.kind}}" class="exercise-art {{item.kind}}-motion" aria-hidden="true">
          <exercise-motion wx:if="{{item.kind === 'yoga'}}" class="motion-player" id="motion-{{item.id}}" kind="yoga">
            <view wx:if="{{!artFailed.yoga}}" class="yoga-art"><image class="yoga-sheet" src="/assets/week-illustrations.png" mode="scaleToFill" data-kind="yoga" binderror="onArtError" /></view>
          </exercise-motion>
          <exercise-motion wx:if="{{item.kind === 'running'}}" class="motion-player" id="motion-{{item.id}}" kind="running">
            <image wx:if="{{!artFailed.running}}" class="running-art" src="/assets/today-running.png" mode="aspectFit" data-kind="running" binderror="onArtError" />
          </exercise-motion>
        </view>
      </view>
      <navigator class="record-entry" url="/pages/record/index?planId={{item.id}}" hover-class="card-pressed" aria-label="{{item.name}}，{{item.time}}，{{item.periodExempt ? '生理期免考核，' : ''}}{{item.resultCategory === 'makeup' ? '已补做，' + item.actualDate + '，实际' + item.actualActivity + '，查看结果' : item.resultCategory === 'replacement' ? '替代完成，' + (item.actualDate ? item.actualDate + '，' : '') + '实际' + item.actualActivity + '，查看结果' : item.completed ? '已完成，' + (item.actualDate ? item.actualDate + '，' : '') + '查看结果' : item.result && item.result.status === 'incomplete' ? '未完成' + (item.result.reason ? '，' + item.result.reason : '') + '，查看结果' : item.periodExempt ? '查看原安排，可不记录' : '记录这次运动'}}">
        <text>{{item.resultCategory === 'makeup' ? '已补做 · ' + item.actualDate + ' · 实际' + item.actualActivity : item.resultCategory === 'replacement' ? '替代完成' + (item.actualDate ? ' · ' + item.actualDate : '') + ' · 实际' + item.actualActivity : item.completed ? '已完成' + (item.actualDate ? ' · ' + item.actualDate : '') + ' · 查看结果' : item.result && item.result.status === 'incomplete' ? '未完成' + (item.result.reason ? ' · ' + item.result.reason : '') : item.periodExempt ? '查看原安排 · 可不记录' : '记录这次运动'}}</text><view class="mood-chevron" aria-hidden="true"></view>
      </navigator>
      <button disabled="{{saving}}" class="before-mood-entry {{item.beforeMood || item.beforeMoodNote ? 'has-mood' : ''}}" data-id="{{item.id}}" bindtap="openBeforeMood" hover-class="card-pressed" aria-label="{{item.name}}，运动前心情，{{item.beforeMoodLabel || '尚未选择'}}，{{item.beforeMoodNote ? '已写备注' : '未写备注'}}，点击修改">
        <text>运动前心情</text>
        <view class="before-mood-value"><text>{{item.beforeMoodLabel || (item.beforeMoodNote ? '已写备注' : '试试看')}}{{item.beforeMoodLabel && item.beforeMoodNote ? ' · 有备注' : ''}}</text><view class="mood-chevron" aria-hidden="true"></view></view>
      </button>
    </view>
  </view>
  <navigator class="review-entry" url="/pages/review/index" hover-class="calendar-pressed" aria-label="查看本周回看"><text>本周回看</text><view class="review-chevron" aria-hidden="true"></view></navigator>
  </block>
  <navigator class="profile-entry" url="/pages/profile/index" hover-class="calendar-pressed"><text>我的</text><view class="review-chevron" aria-hidden="true"></view></navigator>
  <view class="share-entry">
    <button class="share-button" open-type="share" hover-class="share-pressed">分享小程序</button>
  </view>
</view>
<page-container show="{{moodSheetOpen}}" position="bottom" round="{{true}}" duration="180" bindclickoverlay="closeBeforeMood" bindafterleave="afterMoodLeave">
  <scroll-view class="mood-sheet-scroll" scroll-y="{{true}}">
  <view class="before-mood-sheet">
    <view class="mood-sheet-header">
      <view class="mood-sheet-title serif" role="heading" aria-level="2">运动前，心情怎么样？</view>
      <button disabled="{{saving}}" class="mood-sheet-close" bindtap="closeBeforeMood" hover-class="status-pressed" aria-label="关闭运动前心情选择"><view class="close-mark" aria-hidden="true"></view></button>
    </view>
    <view wx:if="{{saveError}}" class="period-hint" role="alert">保存提示：{{saveError}}</view>
  <button wx:if="{{saveConflict}}" disabled="{{saving}}" bindtap="reloadAfterConflict">放弃填写并重新读取</button>
    <view class="mood-sheet-context">{{moodActivityName}} · {{moodActivityTime}}</view>
    <view class="mood-options" role="group" aria-label="运动前的心情，单选">
      <button disabled="{{saving}}" wx:for="{{beforeMoodOptions}}" wx:key="value" class="mood-option {{selectedBeforeMood === item.value ? 'mood-selected' : ''}}" data-value="{{item.value}}" bindtap="selectBeforeMood" hover-class="mood-option-pressed" aria-label="{{item.label}}" aria-pressed="{{selectedBeforeMood === item.value}}">
        <view class="mood-face face-{{item.value}}" aria-hidden="true"><view class="mood-eyes"></view><view class="mood-mouth"></view></view>
        <text class="mood-label">{{item.label}}</text>
      </button>
    </view>
    <view class="note-section">
      <view class="note-heading">想说两句吗？<text class="note-optional">（选填）</text></view>
      <view class="note-field {{beforeMoodNoteFocused ? 'is-focused' : ''}}">
        <textarea disabled="{{saving}}" wx:if="{{moodSheetOpen}}" class="mood-textarea" value="{{beforeMoodNote}}" maxlength="200" cursor-spacing="24" adjust-position="{{true}}" show-confirm-bar="{{true}}" bindinput="inputBeforeMoodNote" bindfocus="focusBeforeMoodNote" bindblur="blurBeforeMoodNote" aria-label="运动前的感受，选填，最多200字" />
        <view class="note-count">{{beforeMoodNote.length}}/200</view>
      </view>
    </view>
    <button disabled="{{saving}}" class="primary-button mood-sheet-done" bindtap="confirmBeforeMood" hover-class="button-pressed">完成</button>
  </view>
  </scroll-view>
</page-container>
