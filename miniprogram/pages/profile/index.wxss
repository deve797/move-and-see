.profile-page { min-height: 100vh; padding: 12px 48rpx 28px; padding-bottom: calc(28px + env(safe-area-inset-bottom)); }
.profile-title { margin-top: 35px; font-size: 40px; font-weight: 700; line-height: 1.3; }
.profile-summary { display: flex; align-items: center; gap: 20px; margin-top: 36px; }
.avatar { position: relative; flex-shrink: 0; width: 80px; height: 80px; overflow: hidden; border-radius: 50%; background: #f3f4f1; }
.avatar-image { width: 100%; height: 100%; }
.avatar-placeholder { position: absolute; inset: 0; color: #71746f; }
.avatar-head { position: absolute; top: 19px; left: 29px; width: 22px; height: 22px; border: 1.5px solid currentColor; border-radius: 50%; }
.avatar-shoulders { position: absolute; bottom: 14px; left: 18px; width: 44px; height: 22px; border: 1.5px solid currentColor; border-radius: 24px 24px 6px 6px; }
.profile-nickname { min-width: 0; overflow-wrap: anywhere; font-size: 22px; line-height: 1.5; font-weight: 500; }
.nickname-unset { color: #71746f; font-size: 18px; font-weight: 400; }
.profile-page .edit-button { display: flex; align-items: center; justify-content: space-between; width: 100%; min-height: 56px; margin: 36px 0 0; padding: 12px 0; border-top: 1px solid #e6e9e3; border-bottom: 1px solid #e6e9e3; border-radius: 0; background: #fff; color: #181917; font-size: 16px; line-height: 1.6; text-align: left; }
.profile-chevron { flex-shrink: 0; width: 8px; height: 8px; margin-right: 4px; border-top: 1.5px solid #50584d; border-right: 1.5px solid #50584d; transform: rotate(45deg); }
.profile-form { margin-top: 36px; }
.field-label { display: block; font-size: 16px; line-height: 1.6; }
.optional-label { color: #71746f; font-size: 14px; }
.profile-page .avatar-choice { display: flex; align-items: center; gap: 20px; width: 100%; min-height: 96px; margin: 8px 0 0; padding: 8px 0; border-radius: 0; background: #fff; color: #50584d; text-align: left; line-height: 1.5; }
.avatar-choice-label { flex: 1; min-width: 0; font-size: 15px; }
.nickname-field { margin-top: 28px; }
.nickname-input-wrap { display: flex; align-items: center; gap: 12px; min-height: 56px; margin-top: 10px; padding: 0 14px; border: 1px solid #ccd4c8; border-radius: 12px; }
.input-focused { border-color: #50584d; }
.nickname-input { flex: 1; min-width: 0; height: 54px; color: #181917; font-size: 16px; caret-color: #20211f; }
.nickname-placeholder, .nickname-count { color: #71746f; }
.nickname-count { flex-shrink: 0; font-size: 13px; font-variant-numeric: tabular-nums; }
.profile-message { margin-top: 24px; color: #50584d; font-size: 14px; line-height: 1.7; }
.field-error { margin-top: 8px; color: #a63823; font-size: 14px; line-height: 1.6; }
.nickname-count.field-error { margin-top: 0; font-size: 13px; }
.profile-page .text-button { width: auto; min-height: 44px; margin: 0; padding: 10px 0; border-radius: 0; background: transparent; color: #50584d; font-size: 15px; line-height: 1.6; text-align: left; }
.profile-page .conflict-button { text-decoration: underline; }
.profile-actions { margin-top: 36px; }
.profile-page .save-button { width: 100%; min-height: 56px; margin: 0; padding: 14px 20px; border-radius: 28px; background: #20211f; color: #fff; font-size: 17px; line-height: 1.5; }
.profile-page .save-button[disabled] { background: #e6e9e3; color: #71746f; }
.profile-page .cancel-button { width: 100%; margin-top: 8px; text-align: center; }
.profile-page .text-button[disabled], .profile-page .avatar-choice[disabled] { color: #71746f; }
.profile-page .profile-pressed { background: #f3f4f1; }
.profile-page .button-pressed { background: #3b3d38; }
@media (max-width: 340px) {
  .profile-page { padding-top: 8px; }
  .profile-title { margin-top: 27px; font-size: 36px; }
  .profile-summary, .profile-form { margin-top: 28px; }
  .profile-nickname { font-size: 20px; }
  .nickname-unset { font-size: 18px; }
}
