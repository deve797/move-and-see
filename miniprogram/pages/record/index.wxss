.record-page { min-height: 100vh; padding: 20px 48rpx 24px; padding-bottom: calc(24px + env(safe-area-inset-bottom)); }
.record-title { font-size: 76rpx; line-height: 1.35; font-weight: 700; letter-spacing: -1px; }
.record-description { margin-top: 12px; color: #71746f; font-size: 16px; line-height: 1.7; }
.period-notice { margin-top: 20px; padding: 14px 16px; border-radius: 12px; background: #e5ece5; color: #344c36; font-size: 14px; line-height: 1.7; }
.period-title { margin-bottom: 4px; font-size: 16px; font-weight: 600; }
.record-scene { margin: 18px -48rpx 0; height: 680rpx; }
.walking-art { display: block; width: 100%; height: 100%; }
.record-summary { margin-top: 14px; text-align: center; }
.record-activity { font-size: 36px; font-weight: 700; line-height: 1.3; }
.activity-time { margin-top: 11px; color: #71746f; font-size: 16px; line-height: 1.7; font-variant-numeric: tabular-nums; }
.record-page .record-next { width: 100%; min-height: 60px; margin-top: 24px; border-radius: 30px; font-size: 21px; line-height: 1.4; }
.record-page .record-next[disabled] { background: #e5ece5; color: #344c36; }
.record-demo { margin-top: 16px; color: #71746f; font-size: 12px; line-height: 1.7; text-align: center; }
.reason-form { margin-top: 28px; }
.reason-heading { font-size: 16px; font-weight: 600; line-height: 1.6; }
.reason-required { color: #71746f; font-size: 14px; font-weight: 400; }
.reason-options { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 12px; }
.record-page .reason-option { width: calc(50% - 4px); min-height: 48px; border: 1px solid #d7dcd4; border-radius: 12px; background: #fff; color: #50584d; font-size: 16px; line-height: 46px; }
.record-page .reason-selected { border-color: #344c36; background: #e5ece5; color: #344c36; font-weight: 600; }
.record-page .record-secondary { width: 100%; min-height: 48px; margin-top: 8px; border-radius: 24px; background: transparent; color: #50584d; font-size: 16px; line-height: 48px; }
.after-mood-entry { text-align: center; }
.running-form { margin-top: 24px; }
.running-hint { margin-top: 4px; color: #71746f; font-size: 14px; line-height: 1.7; }
.running-field { display: flex; align-items: center; gap: 12px; margin-top: 12px; min-height: 52px; }
.running-label { flex-shrink: 0; font-size: 16px; }
.running-input { flex: 1; min-width: 0; height: 48px; padding: 0 12px; border: 1px solid #d7dcd4; border-radius: 12px; background: #fff; color: #252923; font-size: 16px; font-variant-numeric: tabular-nums; }
.running-placeholder { color: #71746f; }
.running-unit { width: 64px; flex-shrink: 0; color: #71746f; font-size: 14px; }
.running-error { margin-top: 12px; color: #a33c26; font-size: 14px; line-height: 1.6; }
.running-pace { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 4px 12px; margin-top: 16px; font-size: 16px; line-height: 1.6; }
.running-pace-value { color: #344c36; font-weight: 600; font-variant-numeric: tabular-nums; }
.record-page .confirm-running-data[disabled] { background: #e5e7e2; color: #62665e; }
.feeling-section { margin-top: 24px; }
.feeling-hint { margin-top: 4px; color: #71746f; font-size: 14px; line-height: 1.7; }
.record-page .feeling-options .reason-option { flex: 1; width: auto; }
.record-page .confirm-incomplete[disabled] { background: #e5e7e2; color: #62665e; }
.record-page .confirm-correction[disabled] { background: #e5e7e2; color: #62665e; }
.record-page .confirm-replacement[disabled] { background: #e5e7e2; color: #62665e; }
.record-page .confirm-makeup[disabled] { background: #e5e7e2; color: #62665e; }
.makeup-activity-heading { margin-top: 20px; }
.makeup-result { margin-top: 16px; padding: 16px; border-radius: 12px; background: #e5ece5; color: #344c36; font-size: 18px; line-height: 1.7; text-align: center; }
.replacement-field { margin-top: 12px; min-height: 52px; padding: 14px 16px; border: 1px solid #d7dcd4; border-radius: 12px; color: #50584d; font-size: 16px; line-height: 1.5; }
.correction-reasons { margin-top: 24px; }
.incomplete-result, .replacement-result { margin-top: 24px; padding: 16px; border-radius: 12px; background: #f3f4f1; color: #50584d; font-size: 18px; line-height: 1.6; text-align: center; }
@media (max-width: 340px) {
  .record-page { padding-top: 16px; }
  .record-description { font-size: 15px; margin-top: 10px; }
  .record-scene { margin-top: 14px; }
  .record-activity { font-size: 32px; }
  .record-page .record-next { min-height: 56px; margin-top: 20px; font-size: 20px; }
}
