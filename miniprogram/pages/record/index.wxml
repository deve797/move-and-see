<view class="record-page">
  <view wx:if="{{loading}}" class="running-hint" role="status">正在读取云端记录…</view>
  <view wx:elif="{{loadError}}" class="running-hint" role="alert">{{loadError}}<button bindtap="retryLoad">重新读取</button></view>
  <block wx:else>
  <view wx:if="{{saving}}" class="running-hint" role="status">正在保存…</view>
  <view wx:if="{{saveError}}" class="running-hint" role="alert">保存提示：{{saveError}}</view>
  <button wx:if="{{saveConflict}}" disabled="{{saving}}" bindtap="reloadAfterConflict">放弃填写并重新读取</button>
  <view class="record-intro">
    <view class="record-title serif" role="heading" aria-level="1">{{plan ? (correcting ? '修正这次结果' : '记下这次运动') : '找不到这条安排'}}</view>
    <view wx:if="{{!plan}}" class="record-description">请返回计划列表选择一条安排。</view>
  </view>
  <view wx:if="{{periodExempt}}" class="period-notice" role="status">
    <view class="period-title">生理期免考核</view>
  </view>
  <view wx:if="{{plan && !replacement && !recordingReplacement && !recordingIncomplete && !incomplete && !correcting}}" class="record-scene" aria-hidden="true">
    <image wx:if="{{!artFailed}}" class="walking-art" src="/assets/record-walking.jpg" mode="aspectFit" binderror="onArtError" />
  </view>
  <view wx:if="{{plan}}" class="record-summary" aria-label="原计划{{plan.activity}}，{{plan.date}}，开始时间{{plan.startTime}}，{{makeup || isLateCompletion ? '已补做' : replacement ? '替代完成，实际' + plan.result.actualActivity : completed ? '已完成' : incomplete ? '未完成' + (selectedReason ? '，' + selectedReason : '') : '尚未记录'}}">
    <view class="record-activity serif">{{plan.activity}}</view>
    <view class="activity-time">计划：{{plan.date}} · {{plan.startTime}}</view>
    <view wx:if="{{resultActualDate && !makeup && !correcting}}" class="actual-date-result">实际运动日期：{{resultActualDate}}</view>
  </view>
  <view wx:if="{{plan && !futurePlan && needsActualDate && ((!plan.result && !recordingIncomplete) || (correcting && correctionStatus === 'completed'))}}" class="actual-date-form">
    <view class="reason-heading">实际运动日期<text wx:if="{{correcting && completed && !plan.result.actualDate}}" class="reason-required">（选填）</text></view>
    <picker disabled="{{saving}}" id="actual-date" mode="date" value="{{actualDate || plan.date}}" start="{{plan.date}}" end="{{makeupEndDate}}" bindchange="selectActualDate">
      <view class="replacement-field" role="button" aria-label="实际运动日期，{{actualDate || '请选择'}}">{{actualDate || '请选择日期'}}</view>
    </picker>
  </view>
  <view wx:if="{{replacement}}" class="replacement-result" role="status">{{isLateCompletion ? '已补做' : '替代完成'}} · 实际{{plan.result.actualActivity}}</view>
  <view wx:if="{{recordingReplacement}}" class="reason-form replacement-form">
    <view class="reason-heading">实际完成的运动<text class="reason-required">（必选）</text></view>
    <picker disabled="{{saving}}" id="replacement-activity" mode="selector" range="{{replacementActivities}}" value="{{replacementActivityIndex}}" bindchange="selectReplacementActivity">
      <view class="replacement-field" role="button" aria-label="实际运动项目，{{actualActivity || '请选择'}}，必填">{{actualActivity || '请选择实际项目'}}</view>
    </picker>
    <button class="record-next primary-button confirm-replacement" disabled="{{saving || (!canConfirmReplacement)}}" bindtap="confirmReplacement" hover-class="button-pressed">确认替代完成</button>
    <button disabled="{{saving}}" class="record-secondary cancel-replacement" bindtap="cancelReplacement" hover-class="button-pressed">暂不记录</button>
  </view>
  <view wx:if="{{incomplete && !correcting}}" class="incomplete-result" role="status">{{makeup ? '原未完成' : '未完成'}}{{selectedReason ? ' · ' + selectedReason : ''}}</view>
  <view wx:if="{{makeup}}" class="makeup-result" role="status">
    <view>已补做 · 实际{{makeup.actualActivity}}</view>
    <view>实际运动日期：{{makeup.date}}</view>
  </view>
  <button disabled="{{saving}}" wx:if="{{canMakeup && !recordingMakeup && !correcting}}" class="record-next primary-button makeup-entry" bindtap="startMakeup" hover-class="button-pressed">为这条计划补做</button>
  <view wx:if="{{recordingMakeup}}" class="reason-form makeup-form">
    <view class="reason-heading">补做日期<text class="reason-required">（必选）</text></view>
    <picker disabled="{{saving}}" id="makeup-date" mode="date" value="{{makeupDate || makeupEndDate}}" start="{{plan.date}}" end="{{makeupEndDate}}" bindchange="selectMakeupDate">
      <view class="replacement-field" role="button" aria-label="补做日期，{{makeupDate || '请选择'}}，必填">{{makeupDate || '请选择补做日期'}}</view>
    </picker>
    <view class="reason-heading makeup-activity-heading">实际完成的运动<text class="reason-required">（必选）</text></view>
    <picker disabled="{{saving}}" id="makeup-activity" mode="selector" range="{{replacementActivities}}" value="{{makeupActivityIndex}}" bindchange="selectMakeupActivity">
      <view class="replacement-field" role="button" aria-label="补做实际项目，{{makeupActivity || '请选择'}}，必填">{{makeupActivity || '请选择实际项目'}}</view>
    </picker>
    <button class="record-next primary-button confirm-makeup" disabled="{{saving || (!canConfirmMakeup)}}" bindtap="confirmMakeup" hover-class="button-pressed">确认补做</button>
    <button disabled="{{saving}}" class="record-secondary cancel-makeup" bindtap="cancelMakeup" hover-class="button-pressed">暂不记录</button>
  </view>
  <view wx:if="{{correcting}}" class="reason-form correction-form">
    <view class="reason-heading">这次的正确结果</view>
    <view class="reason-options" role="group" aria-label="修正运动结果，单选">
      <button disabled="{{saving}}" class="reason-option {{correctionStatus === 'completed' ? 'reason-selected' : ''}}" data-status="completed" bindtap="selectCorrectionStatus" hover-class="button-pressed" aria-pressed="{{correctionStatus === 'completed'}}">已完成</button>
      <button disabled="{{saving}}" class="reason-option {{correctionStatus === 'incomplete' ? 'reason-selected' : ''}}" data-status="incomplete" bindtap="selectCorrectionStatus" hover-class="button-pressed" aria-pressed="{{correctionStatus === 'incomplete'}}">未完成</button>
    </view>
    <view wx:if="{{correctionStatus === 'incomplete'}}" class="correction-reasons">
      <view class="reason-heading">未完成原因<text class="reason-required">{{periodExempt ? '（选填）' : '（必选）'}}</text></view>
      <view class="reason-options" role="group" aria-label="修正后的未完成原因，{{periodExempt ? '选填' : '必选'}}，单选">
        <button disabled="{{saving}}" wx:for="{{reasonOptions}}" wx:key="*this" class="reason-option {{correctionReason === item ? 'reason-selected' : ''}}" data-reason="{{item}}" bindtap="selectCorrectionReason" hover-class="button-pressed" aria-pressed="{{correctionReason === item}}">{{item}}</button>
      </view>
    </view>
    <button class="record-next primary-button confirm-correction" disabled="{{saving || (!canConfirmCorrection)}}" bindtap="confirmCorrection" hover-class="button-pressed">确认修正</button>
    <button disabled="{{saving}}" class="record-secondary cancel-correction" bindtap="cancelCorrection" hover-class="button-pressed">放弃修正</button>
  </view>
  <view wx:if="{{recordingIncomplete}}" class="reason-form">
    <view class="reason-heading">未完成原因<text class="reason-required">（必选）</text></view>
    <view class="reason-options" role="group" aria-label="未完成原因，必选，单选">
      <button disabled="{{saving}}" wx:for="{{reasonOptions}}" wx:key="*this" class="reason-option {{selectedReason === item ? 'reason-selected' : ''}}" data-reason="{{item}}" bindtap="selectReason" hover-class="button-pressed" aria-pressed="{{selectedReason === item}}">{{item}}</button>
    </view>
    <button class="record-next primary-button confirm-incomplete" disabled="{{saving || (!canConfirmIncomplete)}}" bindtap="confirmIncomplete" hover-class="button-pressed">确认未完成</button>
    <button disabled="{{saving}}" class="record-secondary" bindtap="cancelIncomplete" hover-class="button-pressed">暂不记录</button>
  </view>
  <view wx:if="{{isRunning && !recordingReplacement && !recordingIncomplete && !incomplete && !correcting}}" class="running-form">
    <view class="reason-heading">跑步数据<text class="reason-required">（选填）</text></view>
    <label wx:for="{{runningFields}}" wx:key="key" class="running-field">
      <text class="running-label">{{item.label}}</text>
      <input disabled="{{saving}}" class="running-input" type="digit" value="{{runningData[item.key]}}" data-field="{{item.key}}" bindinput="inputRunningData" placeholder="选填" placeholder-class="running-placeholder" aria-label="{{item.label}}，{{item.unit}}，选填" />
      <text class="running-unit">{{item.unit}}</text>
    </label>
    <view wx:if="{{runningPace}}" class="running-pace" role="status">
      <text>平均配速</text>
      <text class="running-pace-value">{{runningPace}}</text>
    </view>
    <view wx:if="{{runningError}}" class="running-error" role="alert">{{runningError}}</view>
    <button wx:if="{{completed}}" class="record-next primary-button confirm-running-data" disabled="{{saving || (!!runningError)}}" bindtap="confirmRunningData" hover-class="button-pressed">确认跑步数据</button>
  </view>
  <button wx:if="{{plan && !replacement && !recordingReplacement && !recordingIncomplete && !incomplete && !correcting}}" class="record-next primary-button confirm-completed" disabled="{{saving || !canComplete || !actualDateValid || (isRunning && !!runningError)}}" hover-class="button-pressed" bindtap="confirmCompleted" aria-label="{{isLateCompletion ? '已补做' : completed ? '已完成' : futurePlan ? '当天可记录' : '确认已完成'}}">
    <text>{{isLateCompletion ? '已补做' : completed ? '已完成' : futurePlan ? '当天可记录' : '确认已完成'}}</text>
  </button>
  <button disabled="{{saving}}" wx:if="{{canComplete && !recordingIncomplete && !recordingReplacement}}" class="record-secondary replacement-entry" bindtap="startReplacement" hover-class="button-pressed">做了其他运动</button>
  <button disabled="{{saving}}" wx:if="{{canComplete && !periodExempt && !recordingIncomplete && !recordingReplacement}}" class="record-secondary" bindtap="startIncomplete" hover-class="button-pressed">未完成</button>
  <view wx:if="{{(completed || makeup) && !correcting}}" class="feeling-section">
    <view class="reason-heading">{{makeup || isLateCompletion ? '这次补做体感' : '这次运动体感'}}<text class="reason-required">（选填）</text></view>
    <view class="reason-options feeling-options" role="group" aria-label="这次运动体感，选填，单选">
      <button disabled="{{saving}}" wx:for="{{feelingOptions}}" wx:key="*this" class="reason-option {{selectedFeeling === item ? 'reason-selected' : ''}}" data-feeling="{{item}}" bindtap="selectFeeling" hover-class="button-pressed" aria-pressed="{{selectedFeeling === item}}">{{item}}</button>
    </view>
    <button disabled="{{saving}}" wx:if="{{selectedFeeling}}" class="record-secondary feeling-clear" data-feeling="" bindtap="selectFeeling" hover-class="button-pressed">清空体感</button>
  </view>
  <navigator wx:if="{{(completed || makeup) && !correcting}}" class="record-secondary after-mood-entry" url="/pages/mood/index?planId={{plan.id}}{{makeup ? '&makeup=1' : ''}}" hover-class="button-pressed">{{makeup || isLateCompletion ? '补做后的感受（选填）' : '运动后感受（选填）'}}</navigator>
  <button disabled="{{saving}}" wx:if="{{canCorrect && !correcting && !recordingMakeup}}" class="record-secondary correction-entry" bindtap="startCorrection" hover-class="button-pressed">修正结果</button>
  </block>
</view>
