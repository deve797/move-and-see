@import "../../styles/calendar.wxss";
.week-page { min-height: 100vh; padding: 8px 48rpx 28px; padding-bottom: calc(28px + env(safe-area-inset-bottom)); }
.week-header { display: flex; align-items: center; justify-content: space-between; }
.week-header .brand { align-self: center; }
.week-intro { margin-top: 27px; }
.week-title { font-size: 80rpx; font-weight: 700; line-height: 1.3; letter-spacing: -1px; }
.week-description { margin-top: 13px; color: #71746f; font-size: 16px; line-height: 1.7; }
.week-range { margin-top: 12px; color: #71746f; font-size: 12px; line-height: 1.5; font-variant-numeric: tabular-nums; }
.week-list { margin-top: 10px; }
.day-row { display: flex; align-items: center; min-height: 78px; border-bottom: 1px solid #eff0ed; text-align: left; }
.day-row:last-child { border-bottom: 0; }
.day-pressed { background: #f4f6f2; }
.day-date { display: flex; flex-direction: column; justify-content: center; flex-shrink: 0; width: 57px; min-height: 43px; border-right: 1px solid #eff0ed; }
.weekday { font-size: 14px; line-height: 1.6; font-weight: 600; }
.date-number { font-size: 12px; line-height: 1.6; color: #71746f; font-variant-numeric: tabular-nums; }
.status-slot { display: flex; width: 48px; flex-shrink: 0; justify-content: center; }
.status-mark { width: 12px; height: 12px; border-radius: 50%; }
.sage { background: #9bad98; }
.orange { background: #fc714c; }
.rest { width: 12px; height: 2px; border-radius: 0; background: #898e86; }
.activity { display: flex; flex: 1; min-width: 0; flex-direction: column; padding: 9px 4px 9px 0; }
.activity-name { font-size: 16px; line-height: 1.6; font-weight: 600; }
.rest-name { color: #71746f; font-weight: 400; font-size: 14px; }
.activity-duration { font-size: 13px; line-height: 1.6; color: #71746f; }
.day-art { position: relative; flex-shrink: 0; width: 58px; height: 58px; overflow: hidden; }
.art-sheet { position: absolute; width: 400%; height: 200%; }
.week-actions { margin-top: 24px; }
.week-page .week-next { width: 100%; min-height: 48px; border-radius: 24px; font-size: 16px; line-height: 1.5; }
.week-page .week-current { width: 100%; min-height: 44px; margin-top: 8px; border-radius: 22px; background: transparent; color: #50584d; font-size: 15px; line-height: 44px; }
.week-page .week-current.day-pressed { background: #f4f6f2; }
.demo-note { margin-top: 20px; color: #71746f; font-size: 12px; line-height: 1.7; }
@media (max-width: 340px) {
  .week-intro { margin-top: 22px; }
  .week-description { font-size: 14px; }
  .day-row { min-height: 70px; }
  .day-date { width: 47px; }
  .status-slot { width: 34px; }
  .day-art { width: 50px; height: 50px; }
  .activity-name { font-size: 15px; }
  .rest-name { font-size: 14px; }
}
