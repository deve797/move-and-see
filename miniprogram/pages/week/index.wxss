@import "../../styles/calendar.wxss";
.week-page { min-height: 100vh; padding: 8px 48rpx 28px; padding-bottom: calc(28px + env(safe-area-inset-bottom)); }
.week-header { display: flex; align-items: center; justify-content: space-between; }
.week-header .brand { align-self: center; }
.week-intro { margin-top: 27px; }
.week-title { font-size: 80rpx; font-weight: 700; line-height: 1.3; letter-spacing: -1px; }
.week-range { margin-top: 12px; color: #71746f; font-size: 12px; line-height: 1.5; font-variant-numeric: tabular-nums; }
.week-list { margin-top: 10px; }
.day-group { border-bottom: 1px solid #eff0ed; }
.day-group:last-child { border-bottom: 0; }
.day-row { display: flex; align-items: flex-start; min-height: 78px; padding: 14px 0; text-align: left; }
.day-pressed { background: #f4f6f2; }
.day-date { display: flex; flex-direction: column; justify-content: center; flex-shrink: 0; width: 57px; min-height: 43px; border-right: 1px solid #eff0ed; }
.weekday { font-size: 14px; line-height: 1.6; font-weight: 600; }
.date-number { font-size: 12px; line-height: 1.6; color: #71746f; font-variant-numeric: tabular-nums; }
.day-content { flex: 1; min-width: 0; margin-left: 16px; }
.day-empty { display: flex; align-items: center; min-height: 43px; color: #71746f; font-size: 14px; line-height: 1.6; }
.week-page .day-add { display: flex; align-items: center; justify-content: center; flex-shrink: 0; width: 44px; height: 44px; margin: 0 0 0 8px; padding: 0; border-radius: 22px; background: transparent; color: #50584d; }
.week-page .day-add.day-pressed { background: #f4f6f2; }
.add-icon { position: relative; width: 16px; height: 16px; }
.add-icon::before, .add-icon::after { content: ""; position: absolute; background: currentColor; border-radius: 1px; }
.add-icon::before { width: 16px; height: 1.5px; top: 7.25px; left: 0; }
.add-icon::after { width: 1.5px; height: 16px; top: 0; left: 7.25px; }
.week-actions { margin-top: 24px; }
.week-page .week-next { width: 100%; min-height: 48px; border-radius: 24px; font-size: 16px; line-height: 1.5; }
.week-page .week-current { width: 100%; min-height: 44px; margin-top: 8px; border-radius: 22px; background: transparent; color: #50584d; font-size: 15px; line-height: 44px; }
.week-page .week-current.day-pressed { background: #f4f6f2; }
.added-plan { padding: 12px 16px; margin-bottom: 12px; background: #f4f6f2; border-radius: 12px; }
.added-plan:last-child { margin-bottom: 0; }
.added-label { color: #50584d; font-size: 12px; line-height: 1.6; }
.period-badge { margin-top: 8px; color: #344c36; font-size: 14px; font-weight: 600; line-height: 1.6; }
.added-content { display: flex; flex-wrap: wrap; gap: 4px 16px; margin-top: 4px; font-size: 16px; line-height: 1.6; font-weight: 600; }
.added-time { flex-shrink: 0; font-variant-numeric: tabular-nums; }
.plan-record { display: flex; align-items: center; min-height: 44px; margin-top: 4px; color: #344c36; font-size: 14px; line-height: 1.6; }
.week-page .plan-edit { min-height: 44px; margin: 4px 0 0; padding: 0; background: transparent; color: #50584d; font-size: 14px; line-height: 44px; text-align: left; }
.week-page .plan-confirm { width: 100%; min-height: 48px; margin-top: 20px; border-radius: 24px; font-size: 16px; line-height: 1.5; }
.week-page .plan-confirm[disabled] { background: #e5e7e2; color: #62665e; }
.plan-form { margin-top: 24px; }
.form-title { font-size: 20px; line-height: 1.5; font-weight: 600; }
.form-hint { margin-top: 8px; color: #71746f; font-size: 13px; line-height: 1.7; }
.form-field { display: flex; align-items: center; justify-content: space-between; gap: 12px; min-height: 56px; border-bottom: 1px solid #eff0ed; font-size: 16px; }
.field-label { flex-shrink: 0; font-weight: 600; }
.field-placeholder { color: #71746f; }
.week-page .plan-cancel { min-height: 44px; margin-top: 8px; background: transparent; border-radius: 22px; color: #50584d; font-size: 15px; line-height: 44px; }
@media (max-width: 340px) {
  .week-intro { margin-top: 22px; }
  .day-row { min-height: 70px; }
  .day-date { width: 47px; }
}
