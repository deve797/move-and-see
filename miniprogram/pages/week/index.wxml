<view class="week-page">
  <view wx:if="{{loading}}" class="form-hint" role="status">正在读取云端记录…</view>
  <view wx:elif="{{loadError}}" class="form-hint" role="alert">{{loadError}}<button bindtap="retryLoad">重新读取</button></view>
  <block wx:else>
  <view wx:if="{{saving}}" class="form-hint" role="status">正在保存…</view>
  <view wx:if="{{saveError}}" class="form-hint" role="alert">保存提示：{{saveError}}</view>
  <button wx:if="{{saveConflict}}" disabled="{{saving}}" bindtap="reloadAfterConflict">放弃填写并重新读取</button>
  <view class="week-header">
    <view class="brand serif">Move&See</view>
    <picker disabled="{{saving}}" wx:if="{{!adding}}" mode="date" value="{{selectedDate}}" bindchange="selectWeek">
      <view class="calendar-button" role="button" aria-label="选择日期，查看所在周">
        <view class="calendar-icon" aria-hidden="true"><view class="calendar-binding"></view><view class="calendar-dot"></view></view>
      </view>
    </picker>
  </view>
  <view class="week-intro">
    <view class="week-title serif" role="heading" aria-level="1">{{title}}</view>
    <view class="week-range">{{range}}</view>
  </view>
  <view wx:if="{{adding}}" class="plan-form">
    <view class="form-title" role="heading" aria-level="2">{{editingId !== null ? '修改运动安排' : '新增运动安排'}}</view>
    <picker wx:if="{{editingId !== null}}" disabled="{{saving}}" id="plan-date" mode="date" value="{{draft.date}}" bindchange="selectPlanDate">
      <view class="form-field" role="button" aria-label="日期，{{draft.date}}，点击选择"><text class="field-label">日期</text><text>{{draft.date}}</text></view>
    </picker>
    <view wx:else class="form-field"><text class="field-label">日期</text><text>{{draftDateLabel}}</text></view>
    <picker disabled="{{saving}}" id="plan-activity" mode="selector" range="{{activities}}" value="{{activityIndex}}" bindchange="selectActivity">
      <view class="form-field" role="button" aria-label="项目，{{draft.activity || '请选择'}}，必填"><text class="field-label">项目</text><text class="{{draft.activity ? '' : 'field-placeholder'}}">{{draft.activity || '请选择项目'}}</text></view>
    </picker>
    <picker disabled="{{saving}}" id="plan-time" mode="multiSelector" range="{{startTimeOptions}}" value="{{startTimeIndex}}" bindchange="selectStartTime">
      <view class="form-field" role="button" aria-label="开始时间，{{draft.startTime || '请选择'}}，必填"><text class="field-label">开始时间</text><text class="{{draft.startTime ? '' : 'field-placeholder'}}">{{draft.startTime || '请选择时间'}}</text></view>
    </picker>
    <view wx:if="{{editingId !== null && !canConfirm && draft.activity && draft.startTime}}" class="form-hint" role="alert">请选择未来的开始时间</view>
    <button class="plan-confirm primary-button" disabled="{{saving || (!canConfirm)}}" bindtap="confirmAdding" hover-class="button-pressed">{{editingId !== null ? '确认修改' : '确认添加'}}</button>
    <button disabled="{{saving}}" class="plan-cancel" bindtap="cancelAdding" hover-class="day-pressed">{{editingId !== null ? '放弃编辑' : '取消填写'}}</button>
  </view>
  <view wx:if="{{!adding}}" class="week-list">
    <view wx:for="{{days}}" wx:key="date" class="day-group">
    <view class="day-row">
      <view class="day-date"><text class="weekday">{{item.weekday}}</text><text class="date-number">{{item.shortDate}}</text></view>
      <view class="day-content">
    <view wx:if="{{!item.plans.length && !item.periodWalk}}" class="day-empty">暂无安排</view>
    <view wx:if="{{item.periodWalk}}" class="added-plan period-walk-history" aria-label="{{item.date}}，自愿散步30分钟，{{item.periodWalk.status === 'completed' ? '已完成' : item.periodWalk.status === 'incomplete' ? '未完成' : '未记录结果'}}，不计入考核">
      <text class="added-label">自愿散步 · 不计入考核</text>
      <view class="added-content">散步 · 30 分钟</view>
      <view class="period-badge">{{item.periodWalk.status === 'completed' ? '已完成' : item.periodWalk.status === 'incomplete' ? '未完成' : '未记录结果'}}</view>
    </view>
    <view wx:for="{{item.plans}}" wx:for-item="plan" wx:key="id" class="added-plan" aria-label="{{plan.date}}，我添加的，{{plan.startTime}}，{{plan.activity}}，已添加的安排">
      <view class="added-content"><text class="added-time">{{plan.startTime}}</text><text>{{plan.activity}}</text></view>
      <view wx:if="{{plan.periodExempt}}" class="period-badge" role="status">生理期免考核</view>
      <navigator id="record-plan-{{plan.id}}" class="plan-record" url="/pages/record/index?planId={{plan.id}}" hover-class="day-pressed" aria-label="{{plan.date}} {{plan.startTime}}的{{plan.activity}}，{{plan.periodExempt ? '生理期免考核，' : ''}}{{plan.resultCategory === 'makeup' ? '已补做，' + plan.actualDate + '，实际' + plan.actualActivity + '，查看结果' : plan.resultCategory === 'replacement' ? '替代完成，' + (plan.actualDate ? plan.actualDate + '，' : '') + '实际' + plan.actualActivity + '，查看结果' : plan.resultCategory === 'completed' ? '已完成，' + (plan.actualDate ? plan.actualDate + '，' : '') + '查看结果' : plan.result.status === 'incomplete' ? '未完成' + (plan.result.reason ? '，' + plan.result.reason : '') + '，查看结果' : plan.periodExempt ? '查看原安排，可不记录' : plan.pendingRecord ? '待补记录，点击记录结果' : '记录结果'}}">
        <text wx:if="{{plan.resultCategory === 'makeup'}}">已补做 · {{plan.actualDate}} · 实际{{plan.actualActivity}} · 查看结果</text>
        <text wx:elif="{{plan.resultCategory === 'replacement'}}">替代完成{{plan.actualDate ? ' · ' + plan.actualDate : ''}} · 实际{{plan.actualActivity}} · 查看结果</text>
        <text wx:elif="{{plan.resultCategory === 'completed'}}">已完成{{plan.actualDate ? ' · ' + plan.actualDate : ''}} · 查看结果</text>
        <text wx:elif="{{plan.result.status === 'incomplete'}}">未完成{{plan.result.reason ? ' · ' + plan.result.reason : ''}} · 查看结果</text>
        <text wx:elif="{{plan.periodExempt}}">查看原安排 · 可不记录</text>
        <text wx:elif="{{plan.pendingRecord}}">待补记录</text>
        <text wx:else>记录结果</text>
      </navigator>
      <button disabled="{{saving}}" wx:if="{{plan.editable}}" class="plan-edit" data-id="{{plan.id}}" bindtap="startEditing" hover-class="day-pressed" aria-label="修改{{plan.date}} {{plan.startTime}}的{{plan.activity}}安排">修改安排</button>
      <button disabled="{{saving}}" wx:if="{{plan.editable}}" class="plan-edit" data-id="{{plan.id}}" bindtap="cancelPlan" hover-class="day-pressed" aria-label="取消{{plan.date}} {{plan.startTime}}的{{plan.activity}}安排">取消安排</button>
    </view>
    </view>
    <button class="day-add" disabled="{{saving}}" data-date="{{item.date}}" bindtap="startAdding" hover-class="day-pressed" aria-label="为{{item.weekday}} {{item.date}}添加运动"><view class="add-icon" aria-hidden="true"></view></button>
    </view>
    </view>
  </view>
  <view wx:if="{{!adding}}" class="week-actions">
    <button disabled="{{saving}}" wx:if="{{!isNextWeek}}" class="week-next primary-button" bindtap="showNextWeek" hover-class="button-pressed" aria-label="安排下周，切换到下周计划">安排下周</button>
    <button disabled="{{saving}}" wx:if="{{!isCurrentWeek}}" class="week-current" bindtap="showCurrentWeek" hover-class="day-pressed">查看本周计划</button>
  </view>
  </block>
</view>
