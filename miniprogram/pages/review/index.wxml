<view class="review-page">
  <view class="review-header"><view class="brand serif">Move&See</view></view>
  <view class="review-intro">
    <view class="review-title serif" role="heading" aria-level="1">本周回看</view>
  </view>
  <view wx:if="{{cloudLoading}}" class="result-detail" role="status">正在读取云端记录…</view>
  <view wx:elif="{{cloudError}}" class="result-detail" role="alert">
    <text>{{cloudError}}</text>
    <button bindtap="retryLoad">重新加载</button>
  </view>
  <block wx:else>
  <view class="review-card summary-card">
    <view class="summary-icon shoe-art" aria-hidden="true"><image wx:if="{{!artFailed}}" class="shoe-sheet" src="/assets/week-illustrations.png" mode="scaleToFill" binderror="onArtError" /></view>
    <view class="summary-copy">
      <view class="card-heading" role="heading" aria-level="2">本周完成</view>
      <view class="summary-line"><view class="summary-value"><text class="summary-number serif">{{weeklyProgress.completed}}</text><text class="summary-unit">次</text></view><view class="summary-detail">{{weeklyProgress.total ? '应完成 ' + weeklyProgress.total + ' 次' : '本周无考核计划'}}</view></view>
    </view>
  </view>
  <view wx:if="{{!hasResults}}" class="review-card results-empty" role="status">本周暂无运动结果</view>
  <block wx:else>
    <view wx:for="{{resultGroups}}" wx:for-item="group" wx:key="key" class="review-card result-group">
      <view class="result-heading"><view class="card-heading" role="heading" aria-level="2">{{group.label}}</view><text class="result-count">{{group.plans.length}} 次</text></view>
      <navigator wx:for="{{group.plans}}" wx:for-item="plan" wx:key="id" class="result-plan" url="/pages/record/index?planId={{plan.id}}" hover-class="back-pressed" aria-label="查看{{plan.date}} {{plan.startTime}} {{plan.activity}}，{{group.label}}">
        <view class="result-activity">{{plan.activity}}</view>
        <view class="result-detail">原计划 · {{plan.date}} {{plan.startTime}}</view>
        <view wx:if="{{group.key === 'completed' && plan.actualDate}}" class="result-detail">实际完成 · {{plan.actualDate}}</view>
        <view wx:if="{{group.key === 'replacement'}}" class="result-detail">实际完成{{plan.actualDate ? ' · ' + plan.actualDate : ''}} · {{plan.actualActivity}}</view>
        <block wx:if="{{group.key === 'makeup'}}">
          <view class="result-detail">补做 · {{plan.actualDate}} · {{plan.actualActivity}}</view>
          <view wx:if="{{plan.result.status === 'incomplete'}}" class="result-detail">原未完成{{plan.result.reason ? ' · ' + plan.result.reason : ''}}</view>
        </block>
        <view wx:if="{{group.key === 'incomplete'}}" class="result-detail">未完成{{plan.result.reason ? ' · ' + plan.result.reason : ''}}</view>
      </navigator>
    </view>
  </block>
  <view wx:if="{{reasonGroups.length}}" class="review-card result-group reason-summary">
    <view class="card-heading" role="heading" aria-level="2">未完成原因</view>
    <view wx:for="{{reasonGroups}}" wx:key="reason" class="result-plan reason-row">
      <view class="result-heading"><text class="result-activity">{{item.reason}}</text><text class="result-count">{{item.count}} 次</text></view>
      <view class="result-detail">其中已补做 {{item.makeupCount}} 次</view>
    </view>
  </view>
  <view class="review-card chart-card">
    <view class="card-heading" role="heading" aria-level="2">最近四周完成率</view>
    <view class="chart-plot">
      <view wx:for="{{weeks}}" wx:key="startDate" class="chart-column" aria-label="{{item.startDate}}至{{item.endDate}}，{{item.isCurrent ? '本周进行中，' : ''}}{{item.total ? item.rate + '%，完成' + item.completed + '次，有效计划' + item.total + '次' : item.emptyLabel}}">
        <view class="bar-value {{!item.total ? 'bar-empty' : ''}}">{{item.total ? item.rate + '%' : item.emptyLabel}}</view>
        <view wx:if="{{item.total}}" class="chart-bar {{item.isCurrent ? 'current-bar' : ''}}" style="height: {{item.rate * 2.4}}rpx;" aria-hidden="true"></view>
      </view>
    </view>
    <view class="chart-labels">
      <view wx:for="{{weeks}}" wx:key="startDate" class="week-label">
        <view class="week-date">{{item.startDate}}</view>
        <view wx:if="{{item.total}}" class="week-count">{{item.completed}} / {{item.total}}</view>
        <view wx:if="{{item.isCurrent}}" class="week-current">进行中</view>
      </view>
    </view>
  </view>
  <view id="mood-summary" class="review-card mood-summary">
    <view class="mood-summary-header">
      <view class="summary-icon bulb-icon" aria-hidden="true"><view class="bulb-head"><view class="bulb-filament"></view></view><view class="bulb-neck"></view><view class="bulb-base"></view></view>
      <view class="summary-copy"><view class="card-heading" role="heading" aria-level="2">前后心情变化</view></view>
    </view>
    <view wx:if="{{!moodComparison.total}}" class="result-none" role="status">暂无可对比的心情记录</view>
    <view wx:else class="mood-comparison">
      <view class="result-plan"><view class="result-heading"><text class="result-activity">改善</text><text class="result-count">{{moodComparison.improved}} 次</text></view></view>
      <view class="result-plan"><view class="result-heading"><text class="result-activity">相同</text><text class="result-count">{{moodComparison.same}} 次</text></view></view>
      <view class="result-plan"><view class="result-heading"><text class="result-activity">下降</text><text class="result-count">{{moodComparison.declined}} 次</text></view></view>
    </view>
    <button class="mood-notes-toggle" bindtap="toggleMoodNotes" hover-class="back-pressed" aria-expanded="{{moodNotesExpanded}}" aria-controls="mood-notes" aria-label="{{moodNotesExpanded ? '收起当时写的话' : '展开当时写的话，查看运动前后的文字'}}">
      <text>{{moodNotesExpanded ? '收起当时写的话' : '看看当时写的话'}}</text><view class="notes-chevron {{moodNotesExpanded ? 'is-expanded' : ''}}" aria-hidden="true"></view>
    </button>
    <view wx:if="{{moodNotesExpanded}}" id="mood-notes" class="mood-notes">
      <view wx:if="{{!moodNotes.length}}" class="result-none" role="status">暂无备注</view>
      <view wx:for="{{moodNotes}}" wx:key="id" class="mood-note-entry">
        <view class="note-entry-heading"><text class="note-activity">{{item.activity}}</text><text class="note-date">{{item.date}}</text></view>
        <view class="result-detail">{{item.context}}</view>
        <view wx:if="{{item.before}}" class="note-line"><text class="note-phase">运动前</text><text class="note-quote" selectable="{{true}}">{{item.before}}</text></view>
        <view wx:if="{{item.after}}" class="note-line"><text class="note-phase">运动后</text><text class="note-quote" selectable="{{true}}">{{item.after}}</text></view>
      </view>
      <button class="mood-notes-collapse" bindtap="collapseMoodNotes" hover-class="back-pressed" aria-label="收起原话并返回前后心情变化">收起原话</button>
    </view>
  </view>
  </block>
  <button class="review-back" hover-class="back-pressed" bindtap="goBack">返回今天</button>
</view>
