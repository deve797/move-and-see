.review-page { min-height: 100vh; padding: 8px 40rpx 24px; padding-bottom: calc(24px + env(safe-area-inset-bottom)); }
.review-header { display: flex; align-items: center; min-height: 44px; padding: 0 8rpx; }
.review-intro { margin: 27px 8rpx 20px; }
.review-title { font-size: 80rpx; line-height: 1.3; font-weight: 700; letter-spacing: -1px; }
.review-description { margin-top: 13px; color: #71746f; font-size: 16px; line-height: 1.7; }
.review-card { background: #f3f4f1; border-radius: 16px; }
.chart-card { margin-top: 24px; padding: 22px 20px 20px; }
.card-heading { font-size: 18px; font-weight: 600; line-height: 1.5; }
.chart-plot { display: flex; align-items: flex-end; height: 170px; margin-top: 8px; border-bottom: 1px solid #dfe3da; }
.chart-column { display: flex; flex: 1; min-width: 0; flex-direction: column; align-items: center; }
.bar-value { margin-bottom: 8px; font-size: 15px; line-height: 1.4; font-variant-numeric: tabular-nums; }
.bar-empty { color: #686d65; font-size: 12px; text-align: center; }
.chart-bar { width: 88rpx; max-width: 44px; border-radius: 30px 30px 0 0; background: #d8e0d5; }
.current-bar { background: #a7b6a0; }
.chart-labels { display: flex; margin-top: 10px; }
.week-label { flex: 1; min-width: 0; color: #686d65; font-size: 13px; line-height: 1.5; text-align: center; }
.week-date { font-size: 11px; }
.week-count { margin-top: 4px; font-size: 14px; font-variant-numeric: tabular-nums; }
.week-current { margin-top: 4px; color: #3e523c; font-size: 12px; }
.summary-card { display: flex; align-items: center; min-height: 112px; margin-top: 16px; padding: 20px; }
.summary-icon { position: relative; flex-shrink: 0; width: 60px; height: 60px; margin-right: 18px; }
.shoe-art { overflow: hidden; }
.shoe-sheet { position: absolute; width: 400%; height: 200%; left: -200%; top: 0; }
.summary-copy { flex: 1; min-width: 0; }
.summary-line { display: flex; align-items: baseline; justify-content: space-between; gap: 8px; margin-top: 2px; }
.summary-value { display: flex; align-items: baseline; gap: 5px; white-space: nowrap; }
.summary-number { font-size: 38px; font-weight: 700; line-height: 1.1; font-variant-numeric: tabular-nums; }
.summary-unit { font-size: 19px; }
.summary-detail { color: #686d65; font-size: 13px; line-height: 1.5; white-space: nowrap; }
.results-scope { margin: 14px 8rpx; color: #686d65; font-size: 13px; line-height: 1.7; }
.results-empty { padding: 24px 20px; color: #686d65; font-size: 15px; line-height: 1.8; }
.result-group { margin-top: 16px; padding: 20px; }
.result-heading { display: flex; align-items: baseline; justify-content: space-between; gap: 12px; }
.result-count { flex-shrink: 0; font-size: 16px; font-variant-numeric: tabular-nums; }
.result-none { margin-top: 12px; color: #686d65; font-size: 14px; line-height: 1.7; }
.result-plan { display: block; margin-top: 16px; padding-top: 16px; border-top: 1px solid #dfe3da; }
.result-activity { font-size: 16px; font-weight: 600; line-height: 1.6; }
.result-detail { margin-top: 5px; color: #686d65; font-size: 13px; line-height: 1.7; overflow-wrap: anywhere; }
.mood-detail { margin-top: 8px; color: #686d65; font-size: 14px; line-height: 1.6; }
.mood-summary { margin-top: 16px; padding: 20px; }
.mood-summary-header { display: flex; align-items: center; min-height: 72px; }
.notes-caption { color: #686d65; font-size: 12px; line-height: 1.6; }
.mood-summary .mood-notes-toggle { display: flex; align-items: center; justify-content: space-between; gap: 12px; width: 100%; min-height: 48px; margin-top: 16px; border-top: 1px solid #dfe3da; border-radius: 0; background: transparent; color: #3e523c; font-size: 14px; line-height: 1.6; text-align: left; }
.notes-chevron { flex-shrink: 0; width: 7px; height: 7px; margin-right: 3px; border-right: 1.5px solid currentColor; border-bottom: 1.5px solid currentColor; transform: translateY(-2px) rotate(45deg); }
.notes-chevron.is-expanded { transform: translateY(2px) rotate(225deg); }
.mood-notes { padding-top: 8px; }
.mood-note-entry { padding: 20px 0; border-bottom: 1px solid #dfe3da; }
.note-entry-heading { display: flex; align-items: baseline; justify-content: space-between; flex-wrap: wrap; gap: 4px 12px; margin-bottom: 12px; }
.note-activity { font-size: 15px; font-weight: 600; line-height: 1.6; }
.note-date { color: #686d65; font-size: 12px; line-height: 1.6; }
.note-line { display: flex; gap: 12px; margin-top: 8px; font-size: 14px; line-height: 1.8; }
.note-phase { flex-shrink: 0; color: #686d65; }
.note-quote { flex: 1; min-width: 0; color: #3e453b; white-space: pre-wrap; overflow-wrap: anywhere; word-break: break-word; }
.mood-summary .mood-notes-collapse { width: 100%; min-height: 44px; margin-top: 12px; border-radius: 0; background: transparent; color: #3e523c; font-size: 14px; line-height: 44px; }
.mood-summary .back-pressed { background: #e5ece5; }
.bulb-head { position: absolute; left: 14px; top: 7px; width: 32px; height: 35px; border: 2px solid #20211f; border-radius: 50%; }
.bulb-head::after { content: ""; position: absolute; left: 8px; bottom: -6px; width: 12px; height: 10px; border-left: 2px solid #20211f; border-right: 2px solid #20211f; background: #f3f4f1; box-sizing: border-box; }
.bulb-filament { position: absolute; z-index: 1; left: 11px; top: 15px; width: 6px; height: 6px; border: 1.5px solid #20211f; border-radius: 50%; }
.bulb-filament::after { content: ""; position: absolute; left: 1px; top: 4px; width: 1.5px; height: 13px; background: #20211f; }
.bulb-neck { position: absolute; left: 22px; top: 46px; width: 16px; height: 2px; background: #20211f; border-radius: 1px; }
.bulb-base { position: absolute; left: 25px; top: 51px; width: 10px; height: 2px; background: #20211f; border-radius: 1px; }
.review-demo { margin: 20px 8rpx 0; color: #71746f; font-size: 12px; line-height: 1.7; text-align: center; }
.review-page .review-back { width: 100%; min-height: 44px; margin-top: 8px; border-radius: 22px; background: transparent; color: #50584d; font-size: 15px; line-height: 44px; }
.back-pressed { background: #f3f4f1; }
@media (max-width: 340px) {
  .review-intro { margin-top: 22px; }
  .review-description { font-size: 14px; }
  .chart-card { padding: 20px 16px 18px; }
  .chart-plot { height: 150px; }
  .card-heading { font-size: 17px; }
  .summary-card { min-height: 106px; padding: 18px 16px; }
  .summary-icon { width: 54px; height: 54px; margin-right: 12px; }
  .summary-number { font-size: 36px; }
  .summary-line { flex-wrap: wrap; }
  .result-group, .results-empty { padding: 18px 16px; }
  .mood-detail { font-size: 13px; }
  .mood-summary { padding: 18px 16px; }
  .mood-summary-header { min-height: 70px; }
  .note-line { gap: 10px; }
}
