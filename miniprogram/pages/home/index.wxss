.home {
  display: flex;
  flex-direction: column;
  min-height: 100vh;
  padding: 12px 48rpx 24px;
  padding-bottom: calc(24px + env(safe-area-inset-bottom));
}
.intro { margin-top: 35px; flex-shrink: 0; }
.headline { font-size: 80rpx; font-weight: 700; line-height: 1.3; letter-spacing: -1px; }
.description { margin-top: 14px; color: #71746f; font-size: 16px; line-height: 1.75; letter-spacing: 1px; }
.description-line { display: block; }
.scene { position: relative; flex: 1; min-height: 440px; margin: 10px -48rpx 0; }
.scene-image { position: absolute; top: 0; left: 0; width: 100%; height: 100%; }
.art-fallback { display: flex; height: 100%; align-items: center; justify-content: center; color: #71746f; font-size: 22px; }
.home .today-button { z-index: 1; flex-shrink: 0; align-self: center; flex-direction: column; width: 112px; height: 112px; border-radius: 50%; margin-top: -24px; font-size: 22px; line-height: 1.45; box-shadow: 0 6px 14px rgba(24,25,23,.12); transition: transform 120ms ease-out, background-color 120ms ease-out; }
.arrow { position: relative; width: 23px; height: 1px; background: currentColor; margin-top: 13px; margin-bottom: 6px; }
.arrow::after { content: ""; position: absolute; right: 0; top: -4px; width: 8px; height: 8px; border-right: 1px solid currentColor; border-top: 1px solid currentColor; transform: rotate(45deg); }
@media (max-width: 340px) {
  .home { padding-top: 8px; padding-bottom: calc(18px + env(safe-area-inset-bottom)); }
  .intro { margin-top: 27px; }
  .description { font-size: 15px; letter-spacing: .5px; margin-top: 10px; }
  .scene { min-height: 375px; }
  .home .today-button { width: 100px; height: 100px; font-size: 20px; }
}
