<view class="detail-page">
  <view class="brand serif">向前动</view>
  <view class="detail-content">
    <view class="detail-title serif" role="heading" aria-level="1">{{activity ? activity.name : '安排详情'}}</view>
    <view wx:if="{{activity}}" class="detail-date">{{date}} {{activity.weekday || ''}}<text wx:if="{{activity.time}}"> · {{activity.time}}</text><text wx:if="{{activity.duration}}"> · {{activity.duration}}</text></view>
    <view class="detail-note">这里将展示当天的运动安排。</view>
    <view class="detail-hint">详情页占位 · 当前内容为界面示例，尚未保存为计划。</view>
    <button class="detail-back primary-button" hover-class="button-pressed" bindtap="goBack">{{returnLabel}}</button>
  </view>
</view>
